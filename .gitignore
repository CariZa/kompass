# Build output
app/build/bin/
app/frontend/dist/*
!app/frontend/dist/gitkeep
app/frontend/node_modules/
app/frontend/package.json.md5

# Kompass's pin store lives in ~/Library/Application Support/Kompass/, not in
# this repo, but never commit a copy of it.
pinned.json

# Kubeconfigs (e.g. a throwaway kind cluster's) must never be committed.
*.kubeconfig
kubeconfig

# Local tooling
.claude/
.DS_Store

# Secrets and local environment
.env
.env.*
*.pem
*.key
